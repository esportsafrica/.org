NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=
# Email (resend.com). Without these, emails are skipped silently.
RESEND_API_KEY=
EMAIL_FROM="Esports Africa <tickets@yourdomain.com>"
CONTACT_EMAIL=info@esportsafrica.org
# Cron protection (Vercel sets the Authorization header from this)
CRON_SECRET=
# Optional bot protection (Cloudflare Turnstile + enable CAPTCHA in Supabase Auth)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
